{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["app/domain/**/*.ts", "tests/domain/**/*.ts"]
}
